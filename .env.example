# ============================================================
# spapp — ตัวอย่างการตั้งค่า
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้เป็นของคุณ
#   copy .env.example .env   (บน Windows)
# ============================================================

# ---------- Shopee Open Platform ----------
# ค่าเหล่านี้ได้จาก https://open.shopee.com > Console > App List
# หลังจากสร้าง app เสร็จและ Shopee อนุมัติแล้ว
SHOPEE_PARTNER_ID=0
SHOPEE_PARTNER_KEY=

# production: https://partner.shopeemobile.com
# sandbox:    https://partner.test-stable.shopeemobile.com
SHOPEE_API_HOST=https://partner.shopeemobile.com

# URL ที่ Shopee ส่ง "code" กลับมาหลังคุณกดอนุญาตให้แอปเข้าถึงร้าน
# ต้องกรอกค่าเดียวกันนี้ไว้ใน Shopee Console ด้วย
SHOPEE_REDIRECT_URL=http://localhost:8080/oauth/callback

# ---------- แอป ----------
# HOST=0.0.0.0 เพื่อเปิดให้เข้าถึงจากมือถือในวงแลนเดียวกัน
HOST=127.0.0.1
PORT=8080

# ดึงข้อมูลจาก Shopee ทุกกี่วินาที (60 = เพียงพอสำหรับเป้าตอบภายใน 1 ชม.)
POLL_INTERVAL_SECONDS=60

# ดึงออเดอร์ย้อนหลังกี่ชั่วโมงไว้เทียบสถานะ
ORDER_LOOKBACK_HOURS=24

# ตำแหน่งไฟล์ฐานข้อมูล (path สัมพัทธ์ = เทียบกับรากโปรเจกต์)
DATABASE_URL=sqlite:///data/spapp.db

# ---------- แจ้งเตือนผ่าน Telegram (ถ้าไม่ใช้ เว้นว่างได้) ----------
# 1. คุยกับ @BotFather ใน Telegram พิมพ์ /newbot เพื่อสร้างบอท แล้วได้ token
# 2. ส่งข้อความอะไรก็ได้ให้บอทของคุณ 1 ข้อความ
# 3. เปิด https://api.telegram.org/bot<TOKEN>/getUpdates แล้วหา "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
